{
  "crons": [
    {
      "path": "/api/seo/run/audit",
      "schedule": "5 4 * * *"
    },
    {
      "path": "/api/seo/run/programmatic",
      "schedule": "5 10 * * *"
    },
    {
      "path": "/api/seo/run/strategy",
      "schedule": "5 16 * * *"
    },
    {
      "path": "/api/seo/run/ideas",
      "schedule": "5 22 * * *"
    },
    {
      "path": "/api/seo/authority",
      "schedule": "15 13 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "assetliftlending.com"
        }
      ],
      "destination": "https://www.assetliftlending.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "header",
          "key": "x-forwarded-proto",
          "value": "http"
        }
      ],
      "destination": "https://www.assetliftlending.com/:path*",
      "permanent": true
    }
  ]
}
